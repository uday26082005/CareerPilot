# Server Runtime
NODE_ENV=production
PORT=5000
CLIENT_URLS=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Supabase Service Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq Multi-API Configuration (Primary -> Backup 1 -> Backup 2)
GROQ_API_KEY=your_primary_groq_api_key
GROQ_API_KEY_2=your_secondary_groq_api_key
GROQ_API_KEY_3=your_tertiary_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# API Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=1mb
FILE_SIZE_LIMIT_MB=5
